// Lily58: 58 keys — wraps the shared 5×3+3 base with:
//   • a number row (all &none)
//   • an outer pinky column on each side (all &none)
//   • encoder positions bottom row (all &none)
//   • an extra outer thumb key on each side (all &none)
#define LILY58_STANDARD_LABELS 1
#include "zmk-helpers/key-labels/lily58.h"

#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH)         \
    ZMK_LAYER(name,                                                    \
        _XXX _XXX _XXX _XXX _XXX _XXX _XXX _XXX _XXX _XXX _XXX _XXX   \
        _XXX LT RT _XXX                                                \
        _XXX LM RM _XXX                                                \
        _XXX LB &kp _XXX &kp _XXX RB _XXX                             \
             _XXX LH RH _XXX                                           \
    )

#include "base.keymap"


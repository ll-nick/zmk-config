    &uc 0x1F44F 0   &uc 0x1F605 0   &uc 0x1F44E 0   &uc 0x1F525 0   &uc 0x1F62C 0,      &uc 0x2764 0    &uc 0x1F602 0   &uc 0x1F618 0   &uc 0x1F923 0   ___,

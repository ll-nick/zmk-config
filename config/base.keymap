//├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
    &uc 0x1F4A4 0   &uc 0x274C 0    &uc 0x2705 0    &uc 0x270C 0    &uc 0x1F60A 0,      &uc 0x1F937 0   &uc 0x1F648 0   &uc 0x1F61C 0   &uc 0x1F61B 0   &uc 0x1F4AA 0,
//  💤              ❌              ✅              ✌️              😊                  🤷              🙈              😜              😛              💪
//╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┴───────────────╯

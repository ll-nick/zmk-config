    &uc 0x2753 0    &uc 0x1F44B 0   &uc 0x1F440 0   &uc 0x1F680 0   &uc 0x1F622 0,      &uc 0x1F389 0   &uc 0x1F44D 0   &uc 0x1F607 0   &uc 0x1F44C 0   &uc 0x1F64F 0,

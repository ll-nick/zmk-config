// Corne (42-key shield): wraps the shared 5×3+3 base with &none for the
// outer pinky column on each side (LT5/LM5/LB5, RT5/RM5/RB5).
// On a 5-column corne those positions have no switches and never fire.
#include "zmk-helpers/key-labels/42.h"

#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH) \
    ZMK_LAYER(name,                                          \
        XXX LT RT XXX                                        \
        XXX LM RM XXX                                        \
        XXX LB RB XXX                                        \
             LH RH                                           \
    )

#include "base.keymap"

/* vim: set ft=c tw=146: */
